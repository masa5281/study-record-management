<% if object.errors.any? %>
  <div id="error-explanation" class="alert alert-danger" role="alert" data-turbo-cache="false">
    <p><%= object.errors.count %>件のエラーがあります。</p>
    <ul>
      <% object.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  </div>
<% end %>
