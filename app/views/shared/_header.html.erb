<header class="header mb-5 py-4 px-4">
  <nav class="header__nav d-flex justify-content-between align-items-start">
    <ul class="header__nav-list header__nav-list--left">
      <li class="me-2">
        <%= link_to '学習記録一覧へ', study_records_path, class: "btn btn-success" %>
        </li>
      <li>
        <%= link_to '学習記録を投稿する', new_study_record_path, class: "btn btn-success" if user_signed_in? %>
        </li>
    </ul>
    
    <ul class="header__nav-list header__nav-list--right">
      <% if user_signed_in? %>
        <li class="me-2">
          <%= link_to 'ユーザー詳細画面へ', user_path(@user), class: "btn btn-secondary" %>
          </li>
        <li>
          <%= link_to 'ログアウト', destroy_user_session_path, data: { turbo_method: :delete }, class: "btn btn-secondary" %>
          </li>
      <% else %>
        <li class="header__nav-item me-2">
          <%= link_to '新規登録', new_user_registration_path, class: "btn btn-warning" %>
          </li>
        <li class="header__nav-item">
          <%= link_to 'ログイン', new_user_session_path, class: "btn btn-warning" %>
          </li>
      <% end %>
    </ul>
  </nav>
</header>
