<%= turbo_frame_tag dom_id(comment) do %>
  <li>
    <p>ユーザー名：<%= comment.user.username %></p>
      <p><%= comment.comment %></p>
      <% if current_user.id == comment.user_id %>
        <%= link_to edit_study_record_comment_path(comment.study_record, comment) do %>
          <i class="fa-solid fa-pen-to-square fa-lg" title="投稿の編集"></i>
        <% end %>
        <%= link_to study_record_comment_path(comment.study_record, comment), data: { turbo_method: :delete, turbo_confirm: '本当に削除してよろしいですか？' } do %>
          <i class="fa-solid fa-trash" title="投稿の削除"></i>
        <% end %>
      <% end %>
    <p><%= l comment.created_at %></p>
  </li>
<% end %>
