<h2>学習記録の詳細ページ</h2>

<ul>
  <li>名前：<%= @study_record.name %></li>
  <li>勉強内容：<%= @study_record.content %></li>
  <li>
    登録タグ：
    <% @study_record.tags.each do |tag| %>
      <%= tag.name %>
    <% end %>
  </li>
</ul>

<% if current_user.id == @study_record.user_id %>
  <div><%= link_to '編集ページへ', edit_study_record_path(@study_record) %></div>
  <div><%= link_to '学習記録を削除', study_record_path(@study_record), data: { turbo_method: :delete, turbo_confirm: '本当に削除してもよろしいですか？' } %></div>
<% end %>