<section class="study-record">
  <div class="study-record__detail">
    <div class="w-50 mx-auto d-flex flex-column justify-content-center">
      <div class="card shadow-sm">
        <div class="card-header"><h2>学習記録の詳細ページ</h2></div>

        <div class="card-body">
          <dl>
            <dt class="study-record__desc-ttl mb-2">ユーザー名</dt>
            <dd class="mb-3"><%= @study_record.name %></dd>
            <dt class="study-record__desc-ttl mb-2">勉強内容</dt>
            <dd class="mb-3"><%= simple_format(@study_record.content) %></dd>
            <dt class="study-record__desc-ttl mb-2">登録タグ</dt>
            <dd class="mb-3">
              <% @study_record.tags.each do |tag| %>
                <span class="d-inline-block bg-dark-subtle rounded"><%= tag.name %></span>
              <% end %>
            </dd>
          </dl>
          <% if current_user.id == @study_record.user_id %>
            <div class="mb-2">
              <%= link_to edit_study_record_path(@study_record), class: "me-2 d-inline-block" do %>
                <i class="fa-solid fa-pen-to-square fa-lg" title="投稿の編集"></i>
              <% end %>
              <%= link_to study_record_path(@study_record), data: { turbo_method: :delete, turbo_confirm: '本当に削除してもよろしいですか？' } do %>
              <i class="fa-solid fa-trash fa-lg" title="投稿の削除"></i>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</section>