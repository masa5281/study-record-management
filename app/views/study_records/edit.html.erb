<section class="study-record">
  <div class="study-record__edit">
    <div class="w-50 mx-auto d-flex flex-column justify-content-center">
      <div class="card shadow-sm">
        <div class="card-header"><h2>学習記録の編集ページ</h2></div>

        <div class="card-body">
          <%= render 'shared/error_messages', { object: @study_record } %>
          <dl>
            <%= form_with model: @study_record do |f| %>
              <dt class="study-record__desc-ttl mb-2">
                <%= f.label :name %>
              </dt>
              <dd class="mb-3">
                <%= f.text_field :name, class: "form-control" %>
              </dd>

              <dt class="study-record__desc-ttl mb-2">
                <%= f.label :content %>
              </dt>
              <dd class="mb-3">
                <%= f.text_area :content, class: "form-control", rows: 5 %>
              </dd>
              
              <dt class="study-record__desc-ttl mb-2">
                <%= f.label :tag_ids %>
              </dt>
              <dd class="mb-3">
              <%= f.collection_check_boxes(:tag_ids, Tag.all, :id, :name) do |tag| %>
                <%= tag.check_box class: "form-check-input" do %>
                  <%= tag.check_box %>
                <% end %>
                <%= tag.label class: "form-check-label" do %>
                  <%= tag.text %>
                <% end %>
              <% end %>
              </dd>

              <%= f.submit class: "btn btn-primary" %>
            <% end %>
          </dl>
        </div>
      </div>
    </div>
  </div>
</section>