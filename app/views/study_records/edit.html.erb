<h2>学習記録の編集画面</h2>

<%= render 'shared/error_messages', { object: @study_record } %>

<%= form_with model: @study_record do |f| %>
  <div>
    <%= f.label :name %>
    <%= f.text_field :name %>
  </div>
  <div>
    <%= f.label :content %>
    <%= f.text_area :content %>
  </div>
  <div>
    <%= f.submit %>
  </div>
<% end %>
