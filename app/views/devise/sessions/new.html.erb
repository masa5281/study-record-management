<section class="user w-50 mx-auto d-flex flex-column justify-content-center">
  <div class="user__login">
    <div class="card shadow-sm">
      <div class="card-header"><h2>ログイン</h2></div>

      <div class="card-body card-body--extend">
        <%= render 'shared/flash' %>
        <%= form_with model: @user, url: user_session_path, local: true do |f| %>
          <div class="mb-4">
            <i class="fa-solid fa-envelope me-1"></i>
            <%= f.label :email, class: "form-label" %>
            <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control" %>
          </div>

          <div class="mb-3">
            <i class="fa-solid fa-lock me-1"></i>
            <%= f.label :password, class: "form-label" %>
            <%= f.password_field :password, autocomplete: "current-password", class: "form-control" %>
          </div>

          <% if devise_mapping.rememberable? %>
            <div class="mb-3">
              <%= f.check_box :remember_me, class: "form-check-input" %>
              <%= f.label :remember_me, class: "form-check-label" %>
            </div>
          <% end %>

          <div class="actions mb-2">
            <%= f.submit "ログイン", class: "btn btn-primary" %>
          </div>
        <% end %>
        <%= render "devise/shared/links" %>
      </div>
    </div>
  </div>
</div>
